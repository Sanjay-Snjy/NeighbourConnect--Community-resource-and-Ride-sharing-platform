# NeighbourHub frontend environment
# Copy to `.env` and adjust as needed. Never commit the real .env.

# ── API ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://neighbourhub-api.onrender.com/api

# ── App settings ──────────────────────────────────────────────────────
VITE_APP_NAME=NeighbourHub
VITE_APP_VERSION=1.0.0

# ── Feature flags ──────────────────────────────────────────────────────
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_WEBSOCKETS=true

# ── UI settings ────────────────────────────────────────────────────────
VITE_THEME=default
VITE_LANGUAGE=en-US