# ─────────────────────────────────────────────────────────────
# NeighbourHub — backend environment (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────

# ── Django core ──
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API (your frontend).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Needed behind HTTPS for the Django admin / browsable API (prod only).
CSRF_TRUSTED_ORIGINS=

# ── Database ──
# Leave DATABASE_URL blank to use SQLite for local development.
# In production, set it to your managed PostgreSQL connection string, e.g.:
#   DATABASE_URL=postgres://user:password@host:5432/neighbourhub
DATABASE_URL=

# ── AWS S3 (production media) ──
# Set USE_S3=True in production to store uploads on S3. Never commit real keys.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
# Optional CloudFront/custom domain for serving media:
AWS_S3_CUSTOM_DOMAIN=

# ── Uploads / security ──
MAX_UPLOAD_SIZE=5242880   # 5 MB, in bytes
# SECURE_SSL_REDIRECT=True # (prod) redirect http→https
